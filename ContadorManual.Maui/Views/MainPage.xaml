<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ContadorManual.Maui.Views.MainPage"
             Title="Contador Manual"
             >

    <VerticalStackLayout
        Spacing="16"
        Margin="16"
        Padding="12">
        <Label 
         Text="conteo:"            
         HorizontalOptions="Fill"
         FontSize="Small"
        />
        <Border
           Stroke="Gray"
           StrokeThickness="2">
            <Label 
            Text="{Binding Path=Conteo }"
            Margin="16"
            Padding="24"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            FontSize="Large"
            FontAttributes="Bold"
            />
        </Border>

        <HorizontalStackLayout 
            Spacing="8">

            <Label VerticalOptions="Center" Text="incrementar conteo por:"/>
            <Entry 
                TextColor="Black"
                BackgroundColor="WhiteSmoke"
                IsReadOnly="True"
                Text="{Binding Source={x:Reference IncrementoStepper},Path=Value}"
                />
            <Stepper Minimum="1"
                     Maximum="20"
                     Increment="1"
                     x:Name="IncrementoStepper"
                     Value="{Binding Path=Incremento}"/>

        </HorizontalStackLayout>
        
        <HorizontalStackLayout
         HorizontalOptions="Center"
         Spacing="36"
         Margin="0,24,0,0">
         <Button
          Text="contar"
          Clicked="OnContarButtonClicked"/>
         <Button 
          Text="reiniciar"
          Clicked="OnReiniciarButtonClicked"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>